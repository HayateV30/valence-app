rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTodayDateKey(dateKey) {
      return dateKey is string
        && dateKey.size() == 10
        && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && dateKey[0:4] == string(request.time.year())
        && dateKey[4:5] == '-'
        && dateKey[7:8] == '-'
        && (
          (request.time.month() < 10 && dateKey[5:6] == '0' && dateKey[6:7] == string(request.time.month())) ||
          (request.time.month() >= 10 && dateKey[5:7] == string(request.time.month()))
        )
        && (
          (request.time.day() < 10 && dateKey[8:9] == '0' && dateKey[9:10] == string(request.time.day())) ||
          (request.time.day() >= 10 && dateKey[8:10] == string(request.time.day()))
        );
    }

    function isValidUserQuota(data) {
      return data.keys().hasAll(['ownerId', 'dateKey', 'actionCount', 'lastActionType', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'dateKey', 'actionCount', 'lastActionType', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && isTodayDateKey(data.dateKey)
        && data.actionCount is int
        && data.actionCount >= 0
        && data.actionCount <= 25
        && data.lastActionType is string
        && data.lastActionType.size() >= 4
        && data.lastActionType.size() <= 16
        && data.lastActionType in ['init', 'import', 'lookup', 'analyze']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /userQuotas/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserQuota(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (incoming().actionCount == 0 && incoming().lastActionType == 'init') ||
          (incoming().actionCount == 1 && incoming().lastActionType in ['import', 'lookup', 'analyze'])
        );

      allow update: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserQuota(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['dateKey', 'actionCount', 'lastActionType', 'updatedAt'])
        && (
          (
            incoming().dateKey == existing().dateKey
            && existing().actionCount < 25
            && incoming().actionCount == existing().actionCount + 1
            && incoming().lastActionType in ['import', 'lookup', 'analyze']
          ) ||
          (
            incoming().dateKey != existing().dateKey
            && (
              (incoming().actionCount == 0 && incoming().lastActionType == 'init') ||
              (incoming().actionCount == 1 && incoming().lastActionType in ['import', 'lookup', 'analyze'])
            )
          )
        );

      allow delete: if false;
    }
  }
}
